{
  "format": "motion-piece.v1",
  "description": "One line fades in and out (0.4 s in, power2.out; 0.35 s out, power2.in; 75 frames at 30 fps). Props texte, police, couleur, corps.",
  "use": "A word or a short line that must simply appear.",
  "avoid": "A long sentence: nothing guides the eye through it.",
  "invariants": [
    "Only the opacity moves."
  ],
  "origin": "Generic mechanism measured on 411 pieces imported from the HyperFrames registry (MOTION-WEB-2026-10 MW4, tools/motion-web-import/mechanisms.py): the most shared entrance and exit, written by hand.",
  "composition": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 75,
    "props": {
      "police": {
        "type": "text",
        "default": "Helvetica Neue"
      },
      "couleur": {
        "type": "color",
        "default": "#FFFFFF"
      },
      "corps": {
        "type": "number",
        "min": 20,
        "max": 300,
        "default": 96
      },
      "texte": {
        "type": "text",
        "default": "Un texte"
      }
    },
    "formats": {
      "16x9": {
        "width": 1920,
        "height": 1080
      },
      "9x16": {
        "width": 1080,
        "height": 1920,
        "props": {
          "corps": 72
        }
      },
      "1x1": {
        "width": 1080,
        "height": 1080,
        "props": {
          "corps": 72
        }
      }
    },
    "root": {
      "type": "fill",
      "style": {
        "fontFamily": {
          "prop": "police"
        },
        "color": {
          "prop": "couleur"
        },
        "justifyContent": "center",
        "alignItems": "center"
      },
      "children": [
        {
          "type": "text",
          "id": "texte",
          "content": {
            "prop": "texte"
          },
          "style": {
            "fontSize": {
              "prop": "corps"
            },
            "fontWeight": 600
          },
          "animate": {
            "opacity": {
              "interpolate": {
                "frames": [
                  0,
                  12,
                  64,
                  75
                ],
                "values": [
                  0,
                  1,
                  1,
                  0
                ],
                "easing": [
                  "power2.out",
                  "linear",
                  "power2.in"
                ]
              }
            }
          }
        }
      ]
    }
  }
}