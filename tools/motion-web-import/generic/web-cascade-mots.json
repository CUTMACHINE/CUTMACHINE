{
  "format": "motion-piece.v1",
  "description": "Words rise in one after the other (each: opacity and 12 px rise over 0.4 s, power2.out, 2 frames apart), hold, fade out together (90 frames at 30 fps). Props texte, police, couleur, corps.",
  "use": "A sentence read word by word: a quote, a promise, a caption to be noticed.",
  "avoid": "More than about ten words: the last one arrives long after the first.",
  "invariants": [
    "Words arrive in reading order, 2 frames apart.",
    "They leave together, not one by one."
  ],
  "origin": "Generic mechanism measured on 411 pieces imported from the HyperFrames registry (MOTION-WEB-2026-10 MW4, tools/motion-web-import/mechanisms.py): the most shared entrance and exit, written by hand.",
  "composition": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 90,
    "props": {
      "police": {
        "type": "text",
        "default": "Helvetica Neue"
      },
      "couleur": {
        "type": "color",
        "default": "#FFFFFF"
      },
      "corps": {
        "type": "number",
        "min": 20,
        "max": 300,
        "default": 88
      },
      "texte": {
        "type": "text",
        "default": "Chaque mot arrive à son tour"
      }
    },
    "formats": {
      "16x9": {
        "width": 1920,
        "height": 1080
      },
      "9x16": {
        "width": 1080,
        "height": 1920,
        "props": {
          "corps": 72
        }
      },
      "1x1": {
        "width": 1080,
        "height": 1080,
        "props": {
          "corps": 72
        }
      }
    },
    "root": {
      "type": "fill",
      "style": {
        "fontFamily": {
          "prop": "police"
        },
        "color": {
          "prop": "couleur"
        },
        "justifyContent": "center",
        "alignItems": "center",
        "paddingLeft": 120,
        "paddingRight": 120
      },
      "animate": {
        "opacity": {
          "interpolate": {
            "frames": [
              0,
              78,
              90
            ],
            "values": [
              1,
              1,
              0
            ],
            "easing": [
              "linear",
              "power2.in"
            ]
          }
        }
      },
      "children": [
        {
          "type": "text",
          "id": "texte",
          "content": {
            "prop": "texte"
          },
          "units": "word",
          "stagger": {
            "each": 2
          },
          "style": {
            "fontSize": {
              "prop": "corps"
            },
            "fontWeight": 700,
            "textAlign": "center"
          },
          "animate": {
            "opacity": {
              "interpolate": {
                "frames": [
                  0,
                  12
                ],
                "values": [
                  0,
                  1
                ],
                "easing": "power2.out"
              }
            },
            "translateY": {
              "interpolate": {
                "frames": [
                  0,
                  12
                ],
                "values": [
                  12,
                  0
                ],
                "easing": "power2.out"
              }
            }
          }
        }
      ]
    }
  }
}