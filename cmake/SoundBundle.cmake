# SN7 -- docs/roadmap/SON-2026-10.md. The sound runtime as one classic script, embedded in
# cutmachine-sound-host as a C++ string.
#
# A JSContext has no module loader and no node:vm. The modules of tools/cutmachine-sound are
# concatenated in dependency order, their `import` lines removed and their `export` keywords
# dropped; node:vm becomes a Function whose parameters are the sandbox's names (the prototype of
# SN6 measured the same samples that way). Built by CMake, so that building the engine never needs
# Node.
#
#   cmake -DSOUND_DIR=<tools/cutmachine-sound> -DOUTPUT=<file.cc> -P SoundBundle.cmake

set(_modules time.mjs edl.mjs project.mjs partition.mjs runtime.mjs wav.mjs job.mjs)

set(_script "'use strict';
// node:vm, as far as runtime.mjs uses it: a context is its sandbox, and code runs with the
// sandbox's names as the parameters of a function.
const vm = {
    createContext(sandbox) { return sandbox; },
    runInContext(code, ctx) {
        const names = Object.keys(ctx).filter((k) => /^[A-Za-z_$][\\w$]*$/.test(k));
        return Function(...names, code)(...names.map((k) => ctx[k]));
    },
};
")

foreach(_module IN LISTS _modules)
    file(READ "${SOUND_DIR}/${_module}" _text)
    set(_text "\n${_text}")
    # Import lines, and `export { ... }` lists, go; `export` before a declaration goes.
    string(REGEX REPLACE "\nimport [^\n]*" "\n" _text "${_text}")
    string(REGEX REPLACE "\nexport *\\{[^\n]*" "\n" _text "${_text}")
    string(REGEX REPLACE "\nexport +(async +function|function|const|let|class)" "\n\\1"
           _text "${_text}")
    string(APPEND _script "\n// ── ${_module}${_text}")
endforeach()

# What the host calls (SoundHost.mm): runJob, then the report as the CLI prints it.
string(APPEND _script "
let cmSoundLast = null;
globalThis.cmSoundRun = function (jobJson) {
    cmSoundLast = runJob(JSON.parse(jobJson), { now: () => Date.now() });
    const { main, stems } = cmSoundLast;
    return { bytes: main.bytes, dataOffset: main.dataOffset, stems: stems.map((s) => ({ fileName: s.fileName, bytes: s.wav.bytes })) };
};
// The report as worker.mjs answers it, key for key: the stems' files are written in stemsDir.
globalThis.cmSoundReport = function (out, sha256, stemsDir) {
    let dir = stemsDir || '';
    while (dir.endsWith('/')) dir = dir.slice(0, -1);
    const stems = stemsDir ? cmSoundLast.stems.map((s) => ({ name: s.name, file: dir + '/' + s.fileName, peakDb: s.peakDb })) : [];
    return JSON.stringify({ ok: true, out, sha256, ...cmSoundLast.report, stems }, null, 2);
};
")

string(FIND "${_script}" ")cmsound\"" _clash)
if(NOT _clash EQUAL -1)
    message(FATAL_ERROR "the sound runtime holds the raw string's delimiter )cmsound\"")
endif()
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/SoundBundle.cmake from tools/cutmachine-sound -- do not edit.
extern const char kSoundRuntimeBundle[];
const char kSoundRuntimeBundle[] = R\"cmsound(${_script})cmsound\";
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
