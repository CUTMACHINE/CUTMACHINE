# PRD18 -- ROADMAP.md (ACP4, docs/roadmap/ACP-2026-09.md). Writes the text
# files of the repository's skills (.claude/skills/<name>/...) into a source
# file of the build tree, byte for byte, so that the binary serves them as
# its procedures (src/Procedures.h) with nothing beside it: neither the
# repository nor a path of the build tree.
#
#   cmake -DSKILLS_DIR=<checkout>/.claude/skills -DOUTPUT=<ProceduresData.cc>
#         -P EmbedProcedures.cmake
#
# A procedure is a directory of SKILLS_DIR that holds a SKILL.md. Its files
# are the .md, .json and .py under it, decided by type: the procedure and the
# files it links, the compositions it gives as examples, the scripts it tells
# to run. Anything else -- an image, a font, an editor's leftovers, a hidden
# file -- stays out: nothing binary is served. The size of each file is held
# by tests/procedures_tests.cc rather than here, so that a long skill fails a
# test instead of the build of the engine.
#
# The bytes are written as numbers, not as string literals: a raw literal
# cannot hold its own delimiter, and a compiler may rewrite the line ends
# inside one. The build runs this script only when a skill file or the
# script itself changed (CMakeLists.txt), and it then writes OUTPUT anew.

cmake_minimum_required(VERSION 3.24)

foreach(_required IN ITEMS SKILLS_DIR OUTPUT)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "EmbedProcedures.cmake needs -D${_required}=...")
    endif()
endforeach()

set(_arrays "")
set(_entries "")
set(_index 0)
file(GLOB _markers LIST_DIRECTORIES false RELATIVE "${SKILLS_DIR}"
     "${SKILLS_DIR}/*/SKILL.md")
list(SORT _markers)
foreach(_marker IN LISTS _markers)
    get_filename_component(_procedure "${_marker}" DIRECTORY)
    set(_root "${SKILLS_DIR}/${_procedure}")
    file(GLOB_RECURSE _candidates LIST_DIRECTORIES false RELATIVE "${_root}"
         "${_root}/*")
    set(_files "")
    foreach(_path IN LISTS _candidates)
        # A hidden file, or anything under a hidden directory, is not part
        # of the procedure.
        if(_path MATCHES "(^|/)\\.")
            continue()
        endif()
        if(_path MATCHES "\\.(md|json|py)$")
            list(APPEND _files "${_path}")
        endif()
    endforeach()
    list(SORT _files)
    foreach(_path IN LISTS _files)
        file(READ "${_root}/${_path}" _hex HEX)
        string(LENGTH "${_hex}" _digits)
        math(EXPR _size "${_digits} / 2")
        if(_size EQUAL 0)
            # A zero-sized array is not C++: an empty file keeps one byte of
            # storage and declares a size of 0.
            set(_bytes "0")
        else()
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        endif()
        # The names go into string literals: a backslash or a quote in one
        # must not end it.
        set(_names "")
        foreach(_name IN ITEMS "${_procedure}" "${_path}")
            string(REPLACE "\\" "\\\\" _name "${_name}")
            string(REPLACE "\"" "\\\"" _name "${_name}")
            string(APPEND _names "\"${_name}\", ")
        endforeach()
        string(APPEND _arrays
               "const unsigned char kFile${_index}[] = {${_bytes}};\n")
        string(APPEND _entries
               "        {${_names}kFile${_index}, ${_size}},\n")
        math(EXPR _index "${_index} + 1")
    endforeach()
endforeach()

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedProcedures.cmake from .claude/skills: do not
// edit, edit the skills. PRD18 -- ROADMAP.md.

#include \"Procedures.h\"

namespace {

${_arrays}
}  // namespace

const EmbeddedProcedureFile* EmbeddedProcedureFiles(size_t& count) {
    // The last entry only keeps the table from being empty.
    static const EmbeddedProcedureFile kFiles[] = {
${_entries}        {nullptr, nullptr, nullptr, 0},
    };
    count = sizeof(kFiles) / sizeof(kFiles[0]) - 1;
    return kFiles;
}
")
